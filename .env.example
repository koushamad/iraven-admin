# Copy to .env.local and fill in values

# App URL (used in magic-link emails and auth redirects)
APP_URL=https://admin.iraven.io

# SQLite DB path (default: iraven.db in cwd; override for persistent volume)
DATABASE_PATH=/data/iraven.db

# Iron-session secret — must be at least 32 chars
SESSION_PASSWORD=change-me-to-a-random-32-char-secret

# SMTP for magic-link emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@iraven.io
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@iraven.io
